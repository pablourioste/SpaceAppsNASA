# --- Datos pesados (se comparten por Drive, no por git) ---
data/raw/**
data/interim/**
data/processed/**
!data/**/
!data/**/.gitkeep
!data/**/README.md
# Las LISTAS de lo descargado sí van a git (para reproducir y comparar), los datos no
!data/raw/**/MANIFEST.csv
!data/raw/**/LISTADO_*.csv
# Las FICHAS (resúmenes por sitio, KB) sí van a git; los intermedios grandes (parquet) van por el Drive
!data/processed/*.csv

# Formatos ráster/científicos grandes en cualquier sitio
*.tif
*.tiff
*.img
*.IMG
*.nc
*.h5
*.hdf
*.jp2
*.zip
*.tar.gz

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# --- HTML generado al previsualizar los .md con LaTeX ---
docs/**/*.html

# --- Node / frontend ---
node_modules/
dist/
build/
.next/

# --- Entorno y secretos ---
.env
*.key
credentials*.json

# --- SO / editores ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# --- Vídeos pesados de la presentación ---
presentation/**/*.mp4
presentation/**/*.mov

# --- Local Claude Code config (preview server) ---
.claude/
